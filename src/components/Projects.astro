---
import GitHub from "./icons/GitHub.astro"
import Blender from "./icons/Blender.astro"
import Cplusplus from "./icons/Cplusplus.astro"
import Unreal from "./icons/Unreal.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"

const TAGS = {
  UNREAL: {
    name: "Unreal",
    class: "bg-black text-white",
    icon: Unreal,
  },
  CPLUSPLUS: {
    name: "C++",
    class: "bg-[#003159] text-white",
    icon: Cplusplus,
  },
  BLENDER: {
    name: "Blender",
    class: "bg-black text-white",
    icon: Blender,
  },
}
const PROJECTS = [
 {
    title: "EOS Go - Community",
    description: "With over 20k downloads, this plugin simplifies the management of multiplayer game sessions by harnessing the power of Epic Online Services (EOS). Ideal for beginners and experienced developers alike, it provides the foundational tools you need to kickstart your multiplayer projects effortlessly.",
    link: "https://www.fab.com/listings/0adf3cf8-dcc2-453d-a1e9-228dbb2263ad",
    github: "",
    image: "/projects/eos-go-community.webp"
  },
  {
    title: "EOS Go - Ultimate",
    description: "This premium plugin offers an enhanced user interface and a wider range of session management features to meet complex multiplayer needs. The Ultimate ve ensures a seamless, polished, and feature-rich experience, making it the ultimate solution for building professional-grade multiplayer games.",
    link: "https://www.fab.com/listings/5bfd29f7-9ffc-4d23-a5b7-4e547528cf1d",
    github: "",
    image: "/projects/eos-go-ultimate.webp"
  },
   {
    title: "AWS Go Plugin (Work in Progress)",
    description: "Designed to empower developers with seamless cloud integration for their games. Whether creating single-player or multiplayer experiences, this plugin focuses on simplicity and efficiency, providing a streamlined approach to leveraging cloud-based solutions. With AWS Go, game developers can focus on crafting engaging gameplay while leaving the complexities of cloud integration behind.",
    link: "",
    github: "",
    image: "/projects/aws-go-community.webp",
  },
   {
    title: "UMind Plugin (Work in Progress)",
    description: "UMind is a working in progress AI-powered assistant built directly into Unreal Engine, allowing developers to find solutions without leaving the editor. Designed to maintain project privacy, UMind offers general coding guidance and intelligent suggestions. It enhances your workflow, helping you troubleshoot, optimize, and implement features more efficiently, all within the Unreal Engine environment.",
    link: "",
    github: "",
    image: "/projects/u-mind.webp"
  },
  // {
  //   title: "EOS System - Multiplayer Integration Sample",
  //   description: "The EOSSystem implements the Epic Online Services. The primary objective of this project is to establish robust multiplayer sessions within the game.",
  //   link: "https://github.com/fedahumada/EOSSystem/releases",
  //   github: "https://github.com/fedahumada/EOSSystem",
  //   image: "/projects/eos.webp",
  //   tags: [TAGS.UNREAL, TAGS.CPLUSPLUS],
  // },
  // {
  //   title: "AURA - Master of the elements",
  //   description: "Top Down RPG style game, filled with systems architected using Unreal Engine's built-in Gameplay Ability System (GAS) Framework",
  //   link: "https://github.com/fedahumada/Aura/releases",
  //   github: "https://github.com/fedahumada/Aura",
  //   image: "/projects/aura.webp",
  //   tags: [TAGS.UNREAL, TAGS.CPLUSPLUS, TAGS.BLENDER],
  // },
  // {
  //   title: "BLASTER - Aim, Shoot, Reload, Repeat.",
  //   description: "Third Person Shooter style game. Built on Linux. The project uses pixel streaming technology for playing on browsers.",
  //   link: "https://arcanemirage.com/project/3064?token=dd4x0VX1mVrM",
  //   github: "https://github.com/fedahumada/Blaster",
  //   image: "/projects/blaster.webp",
  //   tags: [TAGS.UNREAL, TAGS.CPLUSPLUS, TAGS.BLENDER],
  // },
]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, link, github }) => (
    <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
  <div class="w-full md:w-1/2">
    <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
      <img alt="" class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" loading="lazy" src={image} />
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg">
    <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
      {title}
    </h3>
    <div class="flex flex-wrap mt-2">
      {/* <ul class="flex flex-row mb-2 gap-x-2">
          {tags.map((tag) => (
            <li>
              <span
                class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
              >
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul> */}

      <div class="mt-2 text-gray-700 dark:text-gray-400">{description}</div>
      <footer class="flex items-end justify-start mt-4 gap-x-4">
          {github && (
            <LinkButton href={github}>
              <GitHub class="size-6" />
              Code
              
            </LinkButton>
          )}
          {link && (
            <LinkButton href={link}>
              <Link class="size-4" />
              See it on FAB!
            </LinkButton>
          )}
        </footer>
    </div>
  </div>
</article>
    ))
  }
</div>



